{
  "name": "control-ui",
  "version": "1.0.0",
  "description": "TypeScript webapp for controlling LX parameters via OSC",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "tsx src/server.ts",
    "start:dev": "concurrently \"vite --port 8282 --host\" \"tsx src/server.ts\"",
    "server": "tsx src/server.ts",
    "midi": "tsx src/midi-bridge.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "tsx": "^4.7.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "osc-js": "^2.4.0",
    "webmidi": "^3.1.0",
    "express": "^4.18.2",
    "ws": "^8.16.0"
  }
}